# Copy to .env and edit. Never commit .env.

# --- Required for claude.ai access -------------------------------------------
# The https URL claude.ai will use (no trailing slash, no /mcp). In claude.ai,
# add a custom connector with URL  ${WHATSAPP_MCP_PUBLIC_URL}/mcp
WHATSAPP_MCP_PUBLIC_URL=https://whatsapp.example.com

# --- Optional ------------------------------------------------------------------
# Where the host publishes the MCP port. Keep it on loopback and let a tunnel or
# TLS reverse proxy forward to it. Use 0.0.0.0 only on a private network.
#WHATSAPP_MCP_BIND=127.0.0.1
#WHATSAPP_MCP_PORT=8000

# Approve claude.ai connections with a password instead of (as well as) the
# one-time code printed in `docker compose logs mcp`. Generate the hash with:
#   docker compose run --rm mcp python oauth.py hash-password
#WHATSAPP_MCP_OWNER_PASSWORD_HASH=pbkdf2_sha256$...

# Token lifetimes in seconds (defaults: 1 hour access, 30 days refresh).
#WHATSAPP_MCP_ACCESS_TOKEN_TTL=3600
#WHATSAPP_MCP_REFRESH_TOKEN_TTL=2592000

# Disable all sending tools regardless of OAuth scope.
#WHATSAPP_MCP_READ_ONLY=1

# Bridge-side limits (see README "Security").
#WHATSAPP_ALLOWED_RECIPIENTS=6421xxxxxxx,120363xxxxxxxxxx@g.us
#WHATSAPP_SEND_KNOWN_CHATS_ONLY=1
#WHATSAPP_SEND_RATE_LIMIT=20
#WHATSAPP_MAX_CACHED_MESSAGES=50000

# Cloudflare Tunnel token for `docker compose --profile tunnel up -d`.
#CLOUDFLARE_TUNNEL_TOKEN=
